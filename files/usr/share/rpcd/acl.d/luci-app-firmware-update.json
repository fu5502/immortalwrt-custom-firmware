{
    "luci-app-firmware-update": {
        "description": "Grant access to firmware update RPC",
        "read": {
            "ubus": {
                "luci": [
                    "getFirmwareVersion",
                    "getFirmwareUpdateInfo",
                    "getFirmwareUpdateLog"
                ]
            }
        },
        "write": {
            "ubus": {
                "luci": [
                    "startFirmwareUpdate"
                ]
            }
        }
    }
}
