#!/bin/sh

uci -q set system.@system[0].hostname='ImmortalWrt'
uci -q get system.@imm_init[0] >/dev/null || uci -q add system imm_init >/dev/null
uci -q set system.@imm_init[0].apk_mirror='https://downloads.immortalwrt.org'
uci -q commit system

distfeeds='/etc/apk/repositories.d/distfeeds.list'
if [ -f "$distfeeds" ]; then
	sed -i \
		-e 's#https://downloads\.openwrt\.org#https://downloads.immortalwrt.org#g' \
		-e 's#https://mirrors\.vsean\.net/openwrt#https://downloads.immortalwrt.org#g' \
		"$distfeeds"
fi

for service in tasks quickstart istore openbox openbox-panel; do
	[ -x "/etc/init.d/${service}" ] || continue
	"/etc/init.d/${service}" enable >/dev/null 2>&1
done

# Ensure bypass router firewall defaults: allow forward, disable flow offload (protect TUN mode)
uci -q get firewall.@defaults[0] >/dev/null && {
	uci -q set firewall.@defaults[0].input='ACCEPT'
	uci -q set firewall.@defaults[0].output='ACCEPT'
	uci -q set firewall.@defaults[0].forward='ACCEPT'
	uci -q set firewall.@defaults[0].flow_offloading='0'
	uci -q set firewall.@defaults[0].flow_offloading_hw='0'
	uci -q commit firewall
}

# Ensure LAN firewall zone has masquerade enabled (essential for bypass routing)
uci -q get firewall.@zone[0] >/dev/null && {
	uci -q set firewall.@zone[0].masq='1'
	uci -q commit firewall
}

# Ensure DHCP and IPv6 RA are disabled on LAN to prevent hijacking & conflict with iKuai
uci -q get dhcp.lan >/dev/null && {
	uci -q set dhcp.lan.ignore='1'
	uci -q set dhcp.lan.dhcpv4='disabled'
	uci -q set dhcp.lan.ra='disabled'
	uci -q set dhcp.lan.dhcpv6='disabled'
	uci -q set dhcp.lan.ndp='disabled'
	uci -q commit dhcp
}

# Internal DNS mapping for tg.zyweb.top
grep -q "tg.zyweb.top" /etc/hosts 2>/dev/null || {
	echo "192.168.99.251 tg.zyweb.top" >> /etc/hosts
	echo "240e:36e:701:c8d1::62a tg.zyweb.top" >> /etc/hosts
}

sysconf='/etc/sysupgrade.conf'
if [ -f "$sysconf" ]; then
	for preserve_path in \
		"/opt/open-box/data/" \
		"/opt/open-box/etc/" \
		"/etc/init.d/openbox" \
		"/etc/init.d/openbox-panel" \
		"/usr/share/luci/menu.d/luci-app-openbox.json" \
		"/usr/share/rpcd/acl.d/luci-app-openbox.json" \
		"/www/luci-static/resources/view/openbox/"; do
		grep -qxF "$preserve_path" "$sysconf" || echo "$preserve_path" >> "$sysconf"
	done
fi

# If Open-Box database exists but config.json is missing, auto-compile config
if [ -f /opt/open-box/data/openbox.sqlite ] && [ ! -f /opt/open-box/etc/config.json ]; then
	OPENBOX_ROOT="/opt/open-box" \
	ZASHBOARD_DB_PATH="/opt/open-box/data/openbox.sqlite" \
	LD_LIBRARY_PATH="/opt/open-box/node/lib" \
	/opt/open-box/node/bin/node /opt/open-box/panel/server/cli/deploy.mjs >/dev/null 2>&1 || true
fi

uci -q get openclash.config >/dev/null && {
	uci -q set openclash.config.core_version='linux-amd64-v2'
	uci -q commit openclash
}

# Auto-migrate legacy passwall_server schema (26.7 -> 26.9)
if [ -f /etc/config/passwall_server ]; then
	lua -e '
	local uci = require("luci.model.uci").cursor()
	local need_save = false
	uci:foreach("passwall_server", "user", function(s)
		local id = s[".name"]
		local port = s.port
		local type = s.type
		if port and type then
			need_save = true
			local user_id = "user_" .. (s.remarks or id)
			local username = s.username or s.remarks or "user"
			local password = s.password or ""
			uci:section("passwall_server", "user", user_id, {
				username = username,
				password = password
			})
			local s_opts = {
				enable = s.enable or "1",
				remarks = s.remarks or id,
				type = type,
				port = port,
				accept_lan = s.accept_lan or "1",
				log = s.log or "1"
			}
			if type == "Socks" then
				s_opts.auth = s.auth or "1"
				s_opts.user = user_id
			elseif type == "sing-box" then
				s_opts.protocol = s.protocol or "shadowsocks"
				s_opts.method = s.method or "none"
				s_opts.ss_password = password
				s_opts.password = password
			end
			uci:section("passwall_server", "server", id, s_opts)
			uci:delete("passwall_server", id)
		end
	end)
	if need_save then
		uci:commit("passwall_server")
	end
	' 2>/dev/null || true
fi

[ -d /root/cf_optimize ] && chmod +x /root/cf_optimize/*.sh 2>/dev/null

for disabled_svc in mdadm smartd; do
	[ -x "/etc/init.d/${disabled_svc}" ] && "/etc/init.d/${disabled_svc}" disable >/dev/null 2>&1 || true
done

rm -rf /tmp/luci-indexcache /tmp/luci-indexcache.* /tmp/luci-modulecache

exit 0
